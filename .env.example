# Get a token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefYourTokenHere
# Your chat id (send a message to your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and look for "chat":{"id":...})
# Multiple chat ids allowed, comma separated. Group ids start with -100...
TELEGRAM_CHAT_ID=123456789

# Seconds between checks (keep >= 60 to be polite to lancers.jp)
CHECK_INTERVAL=180

# On the very first run, just remember existing jobs without alerting (true/false)
SKIP_EXISTING_ON_FIRST_RUN=true

# File where already-alerted jobs are remembered
SEEN_FILE=seen_jobs.json
# Keep at most this many job ids in the file
MAX_SEEN=5000

# Network tuning (lancers.jp can be slow to answer automated requests)
CONNECT_TIMEOUT=15
READ_TIMEOUT=90
MAX_RETRIES=4
# Send a Telegram warning if lancers.jp fails this many checks in a row (0 = off)
FAIL_ALERT_AFTER=5